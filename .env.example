# ── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose to the browser. Used only in server-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ────────────────────────────────────────────────────────────────
# All AI calls are made server-side. This key never reaches the browser.
ANTHROPIC_API_KEY=sk-ant-...

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=platform@theinnovationlab.io

# ── Platform ─────────────────────────────────────────────────────────────────
# The base domain for the platform. Used for tenant routing.
NEXT_PUBLIC_PLATFORM_DOMAIN=theinnovationlab.io

# Signing secret for internal API routes (generate with: openssl rand -hex 32)
PLATFORM_SECRET=your-secret-here

# ── Environment ──────────────────────────────────────────────────────────────
# development | staging | production
NODE_ENV=development
